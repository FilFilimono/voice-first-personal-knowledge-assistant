# Скопировать в .env и заполнить. .env в git не попадает.

# --- Окружение ---
# dev — локально (dev-бот, локальная база), prod — на сервере
BRAIN_ENV=dev
# Таймзона владельца: «напомни завтра в 10» считается в ней, а не в UTC сервера
BRAIN_TIMEZONE=Europe/Moscow

# --- База ---
# Совпадает с docker-compose.yml. Драйвер asyncpg — синхронный URL нигде не нужен.
DATABASE_URL=postgresql+asyncpg://brain:brain@localhost:5432/brain

# --- Telegram (обязательно) ---
# Два бота: dev-токен локально, prod-токен на сервере. Заводятся у @BotFather.
# Без него бот и воркер падают на старте с явной ошибкой.
TELEGRAM_BOT_TOKEN=
# Whitelist: чьи сообщения бот вообще обрабатывает. Список ID через запятую.
# Всё, что приходит не отсюда, игнорируется молча. Пустое значение = никого.
TELEGRAM_ALLOWED_USER_IDS=

# --- Google AI Studio (обязательно) ---
# Один ключ на два назначения: расшифровка голоса (Фаза 1) и эмбеддинги (Фаза 2).
GOOGLE_API_KEY=

# --- Расшифровка голоса (ADR-0007, ADR-0009) ---
# Провайдер по умолчанию — аудио напрямую в мультимодальную модель Gemini:
# ключ Google уже есть, третьего счёта не заводится. Окончательный выбор —
# за eval'ом на 20 своих голосовых, см. evals/stt/README.md.
STT_PROVIDER=gemini
# Версия явная, не алиас `*-latest`: алиас провайдер переставит на другую
# модель без предупреждения, и поведение промпта уедет вместе с ним.
# Имя протухает за месяцы — проверять раз в квартал.
STT_MODEL=gemini-3.5-flash-lite
# Потолок длины голосового, секунды. 15 минут — из ADR-0007.
STT_MAX_DURATION_SEC=900

# --- Аудио ---
# Куда складываются голосовые. В git этот каталог не попадает.
AUDIO_DIR=var/audio
# Через сколько дней файл удаляется. Текст хранится вечно.
AUDIO_RETENTION_DAYS=30
