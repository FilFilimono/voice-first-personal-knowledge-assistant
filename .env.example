# Скопировать в .env и заполнить. .env в git не попадает.

# --- Окружение ---
# dev — локально (dev-бот, локальная база), prod — на сервере
BRAIN_ENV=dev
# Таймзона владельца: «напомни завтра в 10» считается в ней, а не в UTC сервера
BRAIN_TIMEZONE=Europe/Moscow

# --- База ---
# Совпадает с docker-compose.yml. Драйвер asyncpg — синхронный URL нигде не нужен.
DATABASE_URL=postgresql+asyncpg://brain:brain@localhost:5432/brain

# --- Telegram (обязательно) ---
# Два бота: dev-токен локально, prod-токен на сервере. Заводятся у @BotFather.
# Без него бот и воркер падают на старте с явной ошибкой.
TELEGRAM_BOT_TOKEN=
# Whitelist: чьи сообщения бот вообще обрабатывает. Список ID через запятую.
# Всё, что приходит не отсюда, игнорируется молча. Пустое значение = никого.
TELEGRAM_ALLOWED_USER_IDS=

# --- Google AI Studio (обязательно) ---
# Один ключ на два назначения: расшифровка голоса (Фаза 1) и эмбеддинги (Фаза 2).
GOOGLE_API_KEY=

# --- Расшифровка голоса (ADR-0007, ADR-0009) ---
# Провайдер по умолчанию — аудио напрямую в мультимодальную модель Gemini:
# ключ Google уже есть, третьего счёта не заводится. Окончательный выбор —
# за eval'ом на 20 своих голосовых, см. evals/stt/README.md.
STT_PROVIDER=gemini
# Версия явная, не алиас `*-latest`: алиас провайдер переставит на другую
# модель без предупреждения, и поведение промпта уедет вместе с ним.
# Имя протухает за месяцы — проверять раз в квартал.
STT_MODEL=gemini-3.5-flash-lite
# Потолок длины голосового, секунды. 15 минут — из ADR-0007.
STT_MAX_DURATION_SEC=900

# --- Эмбеддинги (ADR-0006) ---
EMBEDDING_PROVIDER=gemini
# Имя явное — по той же причине, что у расшифровки и разметки. Размерность
# зафиксирована в схеме как vector(768) и настройкой не меняется: смена
# размерности это миграция колонки и пересборка индекса, а не переменная.
# `gemini-embedding-2` — кандидат к сверке, но сверяется он на eval-наборе
# ретривала, а не по описанию.
EMBEDDING_MODEL=gemini-embedding-001
# Сколько запросов в сутки даёт бесплатный тир. Число **наблюдённое**:
# 20 августа 2026 на 1001-м запросе пришёл 429, и воркер тогда не поднялся
# вовсе (ADR-0014). Провайдер это число меняет, поэтому оно настройка.
# Пустое значение означает «лимит неизвестен» — тогда /status показывает
# расход без остатка, а не выдумывает остаток.
# Сутки у провайдера тихоокеанские: сброс в полночь America/Los_Angeles.
EMBEDDING_DAILY_QUOTA=1000

# --- Разметка, дешёвый тир (ADR-0004, ADR-0011, ADR-0012) ---
# Провайдер текстовой модели. До Фазы 6 подключён только дешёвый тир Gemini;
# обращение к дорогому падает с явной ошибкой, а не деградирует молча.
ENRICH_PROVIDER=gemini
# Версия явная — по той же причине, что у STT. `gemini-2.5-flash-lite`,
# на которой строился расчёт в плане, снята с обслуживания 16.08.2026
# и отвечает 404, оставаясь при этом в списке моделей провайдера.
# Проверяется настоящим вызовом при старте воркера, не сверкой со списком.
# Выбор между 3.5 и 3.1 подтверждается eval'ом классификации, а не прайсом:
# на 600 записях в месяц разница между ними пять центов.
ENRICH_MODEL=gemini-3.5-flash-lite
# Сколько записей уходит в один вызов. Потолок нужен не ради денег, а ради
# ответа: пачка на полсотни записей упирается в лимит вывода, и обрыв приходит
# в виде наполовину разобранного JSON.
ENRICH_BATCH_LIMIT=25
# Суточный лимит запросов к текстовой модели. Оставлен **пустым намеренно**:
# мы его не знаем, а число из головы в /status читалось бы как измеренное.
# Заполнить, когда упрёмся и увидим настоящую границу.
ENRICH_DAILY_QUOTA=

# --- Слой представления (ADR-0015) ---
# С каким текстом работает система: разметка, отрезки, чанки, индекс.
# `verbatim` — дословный, `clean` — вычищенный. Показ владельцу переключением
# не управляется: он всегда идёт по вычищенному, если тот есть.
#
# Переключать **только после** `just eval-cleanup`: потерянное чисткой
# из дословного текста никуда не денется, а из индекса исчезнет молча.
#
# И не только после него: команды полного перепрогона архива в проекте нет.
# `just reindex` и `just reenrich` её НЕ заменяют — они ставят задания только
# на непосчитанное (без чанков, без вектора, без разметки). Переключив флаг
# сегодня, вы получите архив, посчитанный над дословным текстом, и отрезки
# уже заведённых дел, режущие вычищенный, — то есть чужие куски в сводке.
PRESENT_WORKING_TEXT=verbatim

# Чем чистится расшифровка. Выбрана 26.08.2026 сравнением трёх моделей
# на одних и тех же двадцати записях: **0.89 без замечаний против 0.70**
# у gemini-3.5-flash-lite и 0.82 у gemini-3.5-flash.
#
# Решающим было не число, а **класс ошибок**: flash-lite единственная выдумала
# слово из неразборчивого куска («уси с офиса» → «уйти с офиса») и нормализовала
# имя; 3.6-flash не делает ни того, ни другого. Выдуманное слово — это смысл,
# а не форма, и в дословном тексте его потом не отличить от сказанного.
#
# Цена названа вслух: бесплатный тир даёт **20 запросов в сутки на модель**.
# При живом темпе в 8 голосовых чистка съедает 8, названия ~6, запас 6.
# Латентность в день сравнения мерить было нечем — провайдер отвечал
# `503 high demand`, и медианы выросли впятеро у всех трёх моделей.
#
# Стоявшая здесь gemini-3.7-flash снята 25.08.2026: она отдаёт один-два токена
# в секунду и на настоящий запрос чистки не отвечает вовсе.
# Проверяется настоящим вызовом при старте воркера.
CLEANUP_MODEL=gemini-3.6-flash
# Уровень рассуждения у модели чистки. Пусто — **не задан**: провайдеру про
# уровень не говорится вовсе, и тело запроса остаётся прежним. Словарь уровней
# принадлежит провайдеру и у разных моделей разный (`gemini-3.7-flash`
# отвечает `400` на `minimal`, у `gemini-3.5-flash-lite` `minimal` умолчание),
# поэтому значение здесь не перечисляется — неверное ловит проба при старте.
CLEANUP_THINKING_LEVEL=
# Сколько секунд ждать чистку, прежде чем показать дословный вариант.
#
# **Это срок запасного пути, а не задержка показа.** Сообщение перерисовывается
# сразу, как чистка пришла; отложенное задание молчит, если она успела. Поэтому
# большее число в хороший день не видно вовсе, а меньшее — это мигание:
# дословный текст показывается и через секунды подменяется вычищенным.
# Шестьдесят выбраны 26.08.2026 из этого, а не из латентности: одним днём
# её измерить нельзя — 25.08 максимум был 11.6 с, 26.08 тот же набор дал 62.7
# при `503 high demand` у провайдера.
CLEANUP_WAIT_SEC=60
# Чем пишутся названия дел и петель. Та же модель, что чистка, и **это довод
# про квоту, а не про качество**: при живом темпе в 8 голосовых в день чистка
# и названия дают 16 запросов в сутки, а бесплатный тир у 3.6-flash и старше
# — 20 на модель. Упёрлись бы молча: названия просто перестали бы появляться.
# Отменяет ось 4 ADR-0015 в части «названия считаются не дешёвым тиром»,
# см. блок «Обновление» там же. Замера под названия нет — долг заведён.
#
# Основание владельца от 26.08.2026: **название хранится в базе и показывается
# месяцами**, поэтому модель, переписывающая имена, здесь опаснее, чем в чистке.
# Настройка своя, а не наследование CLEANUP_MODEL: задачи разные, и менять
# их порознь надо будет ровно тогда, когда одна из них подведёт.
TITLES_MODEL=gemini-3.6-flash
# Выключатель чистки. `false` возвращает поведение до слоя представления:
# расшифровка показывается сразу и дословно.
CLEANUP_ENABLED=true

# --- Аудио ---
# Куда складываются голосовые. В git этот каталог не попадает.
AUDIO_DIR=var/audio
# Через сколько дней файл удаляется. Текст хранится вечно.
AUDIO_RETENTION_DAYS=30
